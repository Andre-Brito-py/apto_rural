# Copie para .env.producao no servidor e preencha. NUNCA envie o .env.producao ao GitHub.

# Domínio do site (o DNS precisa apontar para o servidor), sem https://
DOMINIO=aptorural.com.br

# Senha do banco: longa e aleatória
POSTGRES_PASSWORD=

# Chave para o hash de CPF/CNPJ (LGPD): longa e aleatória. Não troque depois de carregar o MTE.
DOCUMENTO_HASH_SECRET=

# Chave que cifra os segredos guardados pelo painel (ex.: a chave da OpenAI): openssl rand -hex 32
# Se trocar, é só cadastrar a chave da OpenAI de novo no painel (aba Inteligência artificial).
CHAVE_SEGREDOS=

# Asaas (Pix, cartão, boleto). Chave de produção começa com $aact_prod_.
ASAAS_API_KEY=
ASAAS_AMBIENTE=producao
# Token do webhook (32+ caracteres aleatórios), o mesmo cadastrado no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=

# E-mail por SMTP (qualquer provedor: Brevo, Amazon SES, Resend, Google Workspace…).
# Porta 587 (STARTTLS) ou 465 (TLS). O remetente precisa ser de um domínio verificado no provedor.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="Apto Rural <nao-responda@aptorural.com.br>"

# Dias de backup guardados no servidor
BACKUP_DIAS=14

# Cópia do backup FORA do servidor, cifrada antes de sair (docs/backup-e-vigia.md).
# Qualquer armazenamento compatível com S3; prefira um no Brasil (ex.: AWS sa-east-1).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGIAO=
BACKUP_S3_BUCKET=
BACKUP_S3_CHAVE=
BACKUP_S3_SEGREDO=
# Senha da cifra (openssl rand -hex 32). GUARDE TAMBÉM FORA DO SERVIDOR: sem ela, as cópias não abrem.
BACKUP_EXTERNO_SENHA=
BACKUP_EXTERNO_DIAS=30

# Alertas de fora do servidor (healthchecks.io): site fora do ar e backup que não rodou.
VIGIA_URL_SITE=
VIGIA_URL_BACKUP=

# E-mails com acesso ao painel /admin e que recebem alertas de erro (separados por vírgula)
ADMIN_EMAILS=
