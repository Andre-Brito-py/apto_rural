# Cabeçalhos de segurança do site (usados pelo Caddyfile e pelo ensaio de produção).
(cabecalhos) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# O site só carrega o que é dele: um script injetado de fora não roda. A única exceção é o
		# botão "Continuar com o Google", nos endereços que a documentação do Google indica
		# (developers.google.com/identity/gsi/web/guides/get-google-api-clientid).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# "allow-popups": a janela de escolha da conta Google precisa falar com o site.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
}

# Quando a API não responde (atualização, reinício, queda), o próprio Caddy mostra a página de
# manutenção em vez da tela em branco do 502 (docs/pagina-manutencao.md). Responde 503 com
# Retry-After: para o Google, é fora do ar temporário (não pune o site). As chamadas da API
# (/v1/...) recebem JSON, que as telas já sabem mostrar.
#
# As condições vão nos próprios matchers: com "handle_errors 502 503 504", o Caddy 2.8 troca os
# matchers de dentro pelo dele, e o filtro de /v1/ sumia (achado no ensaio de produção).
(fora_do_ar) {
	handle_errors {
		@fora_api {
			expression `{http.error.status_code} in [502, 503, 504]`
			path /v1/*
		}
		@fora expression `{http.error.status_code} in [502, 503, 504]`
		handle @fora_api {
			import cabecalhos
			header Retry-After "30"
			header Cache-Control "no-store"
			header Content-Type "application/json; charset=utf-8"
			respond `{"erro":{"mensagem":"O Apto Rural está em manutenção por alguns minutos. Tente de novo em instantes."}}` 503
		}
		handle @fora {
			import cabecalhos
			header Retry-After "30"
			header Cache-Control "no-store"
			root * /etc/caddy/manutencao
			rewrite * /manutencao.html
			file_server {
				status 503
			}
		}
	}
}
