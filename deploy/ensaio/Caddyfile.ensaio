# Ensaio de produção: o mesmo site do Caddyfile (HTTPS em localhost) e mais uma entrada
# HTTP em localhost:8081, só neste computador, com os MESMOS cabeçalhos de segurança.
# Ela existe porque o navegador recusa o certificado que o Caddy gera para "localhost".
# O Caddyfile de produção já importa o trecho dos cabeçalhos (cabecalhos.caddy).
import /etc/caddy/Caddyfile.producao

http://localhost:8081 {
	encode zstd gzip
	reverse_proxy api:3333
	import cabecalhos
}
