# Banco PostgreSQL com PostGIS
DATABASE_URL=postgres://apto:apto@localhost:5432/apto_rural

# Porta da API
PORT=3333

# Chave para o hash de CPF/CNPJ (LGPD). Gere uma longa e aleatória.
DOCUMENTO_HASH_SECRET=troque-esta-chave

# 1 = permite o CAR de demonstração (dados fictícios). Nunca ligar em produção.
APTO_DEMO=1

# Origem do site autorizada a chamar a API
WEB_ORIGIN=http://localhost:5173

# Pagamentos (Asaas). Sem chave e com APTO_DEMO=1, usa o pagamento simulado.
# Chaves de sandbox começam com $aact_hmlg_; de produção, com $aact_prod_.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token configurado no webhook do Asaas (32+ caracteres aleatórios; não use a chave da API).
ASAAS_WEBHOOK_TOKEN=
