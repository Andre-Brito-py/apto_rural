{
  "name": "@apto/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrar": "tsx --env-file-if-exists=../../.env src/migrar.ts",
    "monitorar": "tsx --env-file-if-exists=../../.env src/monitorar.ts",
    "contas-locais": "tsx --env-file-if-exists=../../.env scripts/contas-locais.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@apto/regras": "0.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.1.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
